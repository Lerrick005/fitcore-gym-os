<Window x:Class="FitCore.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FitCore" Height="720" Width="1100"
        Background="{DynamicResource Brush.Surface.Base}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="48,24" Background="Transparent">
            <TextBlock Text="FITCORE" Style="{StaticResource Text.Wordmark}"/>
        </Border>

        <Grid Grid.Row="1" Margin="48,0,48,48">
            <Border Style="{StaticResource Card}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="560">
                <StackPanel>
                    <TextBlock Text="Boutique fitness"
                               Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Brand.Primary}"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="FitCore design system" Style="{StaticResource Text.H1}" Margin="0,0,0,16"/>
                    <TextBlock Text="Warm, confident, editorial."
                               Style="{StaticResource Text.Secondary}"
                               Margin="0,0,0,32"/>

                    <Border Style="{StaticResource Divider}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                        <Button Content="Primary action" Style="{StaticResource Button.Primary}" Margin="0,0,12,0"/>
                        <Button Content="Secondary" Style="{StaticResource Button.Secondary}"/>
                    </StackPanel>

                    <TextBlock Text="Sample text input" Style="{StaticResource Text.FieldLabel}"/>
                    <TextBox Style="{StaticResource Input.TextBox}" Text="Type here..."/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
