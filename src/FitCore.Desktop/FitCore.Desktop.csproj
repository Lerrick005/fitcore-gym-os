<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Resources\fitcore.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>FitCore.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FitCore.Application\FitCore.Application.csproj" />
    <ProjectReference Include="..\FitCore.Infrastructure\FitCore.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Fonts\Fraunces-SemiBold.ttf" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Resources\vendor-public-key.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\defaults\fitcore.defaults.json" Link="defaults\fitcore.defaults.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>






