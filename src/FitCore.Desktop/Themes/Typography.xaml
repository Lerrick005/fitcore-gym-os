<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Text.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="Text.H1" BasedOn="{StaticResource Text.Display}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.H1}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="56"/>
    </Style>

    <Style x:Key="Text.H2" BasedOn="{StaticResource Text.Display}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.H2}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Text.H3" BasedOn="{StaticResource Text.Display}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.H3}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Text.Wordmark" BasedOn="{StaticResource Text.Display}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
    </Style>

    <Style x:Key="Text.Body" BasedOn="{StaticResource Text.Base}" TargetType="TextBlock"/>

    <Style x:Key="Text.Secondary" BasedOn="{StaticResource Text.Base}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.BodyLarge}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="LineHeight" Value="28"/>
    </Style>

    <Style x:Key="Text.Caption" BasedOn="{StaticResource Text.Base}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
    </Style>

    <!-- Field label: bigger and bolder -->
    <Style x:Key="Text.FieldLabel" BasedOn="{StaticResource Text.Base}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="Text.Error" BasedOn="{StaticResource Text.Base}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Semantic.Danger}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}"/>

</ResourceDictionary>
