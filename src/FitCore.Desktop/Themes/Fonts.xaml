<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fraunces SemiBold — static TTF, referenced by relative path.
         The font file must be a Resource in the csproj.
         WPF resolves "./Fonts/" relative to the app base directory. -->
    <FontFamily x:Key="Font.Display">./Fonts/#Fraunces</FontFamily>
    <FontFamily x:Key="Font.Body">Segoe UI</FontFamily>

</ResourceDictionary>
