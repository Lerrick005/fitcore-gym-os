<Window x:Class="FitCore.Desktop.Views.Members.NewMemberFlowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New member"
        Width="900" Height="780"
        MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Brush.Surface.Base}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="32,28,32,16">
            <TextBlock Text="New member" Style="{StaticResource Text.H1}"/>
            <TextBlock Text="Register, sell a plan, and take payment in one step." Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="32,0,32,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">
                <TextBlock Text="MEMBER" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Brand.Primary}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Full name" Style="{StaticResource Text.FieldLabel}"/>
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <TextBlock Text="Phone" Style="{StaticResource Text.FieldLabel}"/>
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Email (optional)" Style="{StaticResource Text.FieldLabel}"/>
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <TextBlock Text="Start date" Style="{StaticResource Text.FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding StartDate}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="PLAN" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Brand.Primary}" Margin="0,0,0,12"/>
                <ItemsControl ItemsSource="{Binding Plans}" Margin="0,0,0,20">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectPlanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Width="200" Height="100" Margin="0,0,12,12" Padding="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Text}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Brand.Primary}"/>
                                                <Setter Property="BorderThickness" Value="2"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Border Background="{DynamicResource Brush.Surface.Raised}"
                                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                        BorderThickness="1" CornerRadius="{DynamicResource Radius.Md}" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,6" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PriceDisplay}" Style="{StaticResource Text.H3}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding DurationDisplay}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="PAYMENT" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Brand.Primary}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Amount" Style="{StaticResource Text.FieldLabel}"/>
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding AmountInput, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Method" Style="{StaticResource Text.FieldLabel}"/>
                        <ComboBox Style="{StaticResource Input.ComboBox}" ItemsSource="{Binding Methods}" SelectedItem="{Binding Method}" ItemContainerStyle="{StaticResource Input.ComboBoxItem}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Reference (optional)" Style="{StaticResource Text.FieldLabel}"/>
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" Background="{DynamicResource Brush.Surface.Base}" Padding="32,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsedConverter}}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,12,0"/>
                    <Button Content="Complete &amp; print receipt" Style="{StaticResource Button.Primary}" Command="{Binding CompleteCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
