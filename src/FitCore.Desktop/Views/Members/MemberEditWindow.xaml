<Window x:Class="FitCore.Desktop.Views.Members.MemberEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="560" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Surface.Base}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Border Style="{StaticResource Card}" Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" Margin="0,0,0,24"/>

                <TextBlock Text="Full name" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}"
                         Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"/>

                <TextBlock Text="Phone" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}"
                         Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"/>

                <TextBlock Text="Email (optional)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"/>

                <TextBlock Text="Date of birth (optional)" Style="{StaticResource Text.FieldLabel}"/>
                <DatePicker SelectedDate="{Binding DateOfBirth}" Margin="0,0,0,16"/>

                <TextBlock Text="Gender (optional)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}"
                         Text="{Binding Gender, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"/>

                <TextBlock Text="Emergency contact (optional)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}"
                         Text="{Binding EmergencyContact, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16"/>

                <TextBlock Text="Notes (optional)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}"
                         Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         Height="80"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         Margin="0,0,0,16"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource Text.Error}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsedConverter}}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding CancelCommand}"
                            Margin="0,0,12,0"/>
                    <Button Content="Save"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
