<Window x:Class="FitCore.Desktop.Views.Members.SellPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sell plan"
        Width="780" Height="720"
        MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Brush.Surface.Base}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sell plan" Style="{StaticResource Text.H2}" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="{Binding DisplayName}"
                                       Style="{StaticResource Text.Caption}"
                                       Foreground="{DynamicResource Brush.Brand.Primary}"
                                       Margin="0,0,0,12"/>

                            <ItemsControl ItemsSource="{Binding Plans}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectPlanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Width="210" Height="110"
                                                Margin="0,0,12,12"
                                                Padding="0"
                                                Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Text}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Brand.Primary}"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Border Background="{DynamicResource Brush.Surface.Raised}"
                                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource Radius.Md}"
                                                    Padding="16,14">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource Text.Body}"
                                                               FontWeight="SemiBold"
                                                               Margin="0,0,0,6"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding PriceDisplay}"
                                                               Style="{StaticResource Text.H3}"
                                                               Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding DurationDisplay}"
                                                               Style="{StaticResource Text.Caption}"
                                                               Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Start date: " Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Width="180"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PreviewEndDate}" Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Brand.Primary}"/>
                    <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}"
                               Margin="0,4,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsedConverter}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Cancel" Style="{StaticResource Button.Secondary}"
                            Command="{Binding CancelCommand}" Margin="0,0,12,0"/>
                    <Button Content="Sell" Style="{StaticResource Button.Primary}"
                            Command="{Binding ConfirmCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
