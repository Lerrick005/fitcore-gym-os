<Window x:Class="FitCore.Desktop.Views.Members.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt"
        Width="520" Height="820"
        MinWidth="420" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.Surface.Base}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Border x:Name="ReceiptContent"
                    Background="White"
                    BorderBrush="#E8E1D2"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    Width="{Binding ReceiptWidth}"
                    Padding="20,16">
                <StackPanel>
                    <!-- DUPLICATE watermark -->
                    <Border Background="Transparent" BorderBrush="#B91C1C" BorderThickness="1.5"
                            Padding="4" Margin="0,0,0,8"
                            Visibility="{Binding IsDuplicate, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="DUPLICATE" FontSize="12" FontWeight="Bold" Foreground="#B91C1C" TextAlignment="Center"/>
                    </Border>

                    <TextBlock Text="{Binding BusinessName}"
                               FontSize="{Binding ReceiptFontSize, Converter={StaticResource AddTwoConverter}}"
                               FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding BusinessContact}"
                               FontSize="{Binding ReceiptFontSize}" TextAlignment="Center"
                               Foreground="#444" TextWrapping="Wrap" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding BusinessAddress}"
                               FontSize="{Binding ReceiptFontSize}" TextAlignment="Center"
                               Foreground="#444" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding TaxNumber, StringFormat='PIN: {0}'}"
                               FontSize="{Binding ReceiptFontSize}" TextAlignment="Center"
                               Foreground="#444" Margin="0,0,0,6"
                               Visibility="{Binding ShowTaxLine, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <Border Height="1" Background="#333" Margin="0,4,0,6"/>

                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Receipt: " FontSize="{Binding ReceiptFontSize}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding ReceiptNumber}" FontSize="{Binding ReceiptFontSize}"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Date: " FontSize="{Binding ReceiptFontSize}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding IssuedAt}" FontSize="{Binding ReceiptFontSize}"/>
                    </Grid>

                    <Border Height="1" Background="#999" Margin="0,0,0,6"/>

                    <TextBlock Text="CUSTOMER" FontSize="{Binding ReceiptFontSize}" FontWeight="Bold" Foreground="#666" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding MemberName}" FontSize="{Binding ReceiptFontSize}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding MemberNumber}" FontSize="{Binding ReceiptFontSize}" Foreground="#666" Margin="0,0,0,6"/>

                    <TextBlock Text="PLAN" FontSize="{Binding ReceiptFontSize}" FontWeight="Bold" Foreground="#666" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding PlanName}" FontSize="{Binding ReceiptFontSize}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PlanDates}" FontSize="{Binding ReceiptFontSize}" Foreground="#666" Margin="0,0,0,6"/>

                    <Border Height="1" Background="#999" Margin="0,0,0,6"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Amount paid" FontSize="{Binding ReceiptFontSize}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding AmountDisplay}" FontSize="{Binding ReceiptFontSize}" FontWeight="Bold"/>
                    </Grid>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="via " FontSize="{Binding ReceiptFontSize}" Foreground="#666"/>
                        <TextBlock Grid.Column="1" Text="{Binding Method}" FontSize="{Binding ReceiptFontSize}" Foreground="#666"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Ref " FontSize="{Binding ReceiptFontSize}" Foreground="#666"/>
                        <TextBlock Grid.Column="1" Text="{Binding Reference}" FontSize="{Binding ReceiptFontSize}" Foreground="#666"/>
                    </Grid>

                    <Border Height="1" Background="#333" Margin="0,10,0,6"/>

                    <TextBlock Text="{Binding FooterText}"
                               FontSize="{Binding ReceiptFontSize}" TextAlignment="Center"
                               TextWrapping="Wrap" Foreground="#333"/>

                    <TextBlock Text="Powered by FitCore"
                               FontSize="{Binding ReceiptFontSize}" TextAlignment="Center"
                               Foreground="#999" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" Style="{StaticResource Button.Secondary}" Click="Close_Click" Margin="0,0,12,0"/>
            <Button Content="Print" Style="{StaticResource Button.Primary}" Command="{Binding PrintCommand}"/>
        </StackPanel>
    </Grid>
</Window>
