<UserControl x:Class="FitCore.Desktop.Views.Members.MemberDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <!-- Back button -->
        <Button Content="← Back to members"
                Style="{StaticResource Button.Text}"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Left"
                Margin="0,0,0,16"/>

        <!-- Header row: name + status + actions -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="{Binding FullName}"
                               Style="{StaticResource Text.H1}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Border Background="{DynamicResource Brush.Brand.Primary}"
                            CornerRadius="{DynamicResource Radius.Sm}"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Status}"
                                   FontSize="11"
                                   Foreground="#FFFFFF"
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding MemberNumber}"
                           Style="{StaticResource Text.Caption}"
                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                           Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Phone}" Style="{StaticResource Text.Secondary}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding Email}" Style="{StaticResource Text.Secondary}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Check in"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding CheckInCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="Record payment"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding RecordPaymentCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="Sell plan"
                        Style="{StaticResource Button.Secondary}"
                        Command="{Binding SellPlanCommand}"
                        IsEnabled="{Binding CanSellPlan}"
                        Margin="0,0,8,0"/>
                <Button Content="Renew"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding RenewCommand}"
                        Visibility="{Binding IsExpired, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>

        <!-- Active membership card -->
        <Border Style="{StaticResource Card}"
                Margin="0,0,0,24"
                Visibility="{Binding HasActiveMembership, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CURRENT PLAN" Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding ActivePlanName}"
                                   Style="{StaticResource Text.H2}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding ActivePriceDisplay}"
                                   Style="{StaticResource Text.H3}"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding ActiveStatus}"
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Brand.Primary}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Divider}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="STARTED" Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                        <TextBlock Text="{Binding ActiveStartDateDisplay}" Style="{StaticResource Text.Body}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="ENDS" Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                        <TextBlock Text="{Binding ActiveEndDateDisplay}" Style="{StaticResource Text.Body}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DAYS REMAINING" Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                        <TextBlock Text="{Binding ActiveDaysRemaining, StringFormat={}{0} days}" Style="{StaticResource Text.Body}"/>
                    </StackPanel>
                </Grid>

                <!-- Progress bar -->
                <ProgressBar Height="6"
                             Margin="0,16,0,0"
                             Minimum="0" Maximum="100"
                             Value="{Binding ActiveProgressPercent, Mode=OneWay}"
                             Foreground="{DynamicResource Brush.Brand.Primary}"
                             Background="{DynamicResource Brush.Border.Subtle}"
                             BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- No active membership state -->
        <Border Style="{StaticResource Card}"
                Margin="0,0,0,24"
                Background="{DynamicResource Brush.Surface.Sunken}"
                Visibility="{Binding HasActiveMembership, Converter={StaticResource BooleanToVisibilityInverseConverter}}">
            <StackPanel>
                <TextBlock Text="No active membership"
                           Style="{StaticResource Text.H3}"
                           Margin="0,0,0,6"/>
                <TextBlock Text="This member has no current plan. Click 'Sell plan' to add one."
                           Style="{StaticResource Text.Secondary}"/>
            </StackPanel>
        </Border>

        <!-- History -->
        <TextBlock Text="MEMBERSHIP HISTORY" Style="{StaticResource Text.Caption}"
                   Foreground="{DynamicResource Brush.Brand.Primary}"
                   Margin="0,0,0,12"/>

        <Border Background="{DynamicResource Brush.Surface.Raised}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Md}">
            <ItemsControl ItemsSource="{Binding MembershipHistory}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding PlanName}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}">
                                        <Run Text="{Binding StartDate, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                                        <Run Text=" → "/>
                                        <Run Text="{Binding EndDate, StringFormat='{}{0:dd/MM/yyyy}'}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Status}"
                                           Style="{StaticResource Text.Caption}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Error -->
        <TextBlock Text="{Binding StatusMessage}"
                   Style="{StaticResource Text.Error}"
                   Margin="0,16,0,0"
                   TextWrapping="Wrap"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToCollapsedConverter}}"/>

    
        <!-- Loyalty card (only when loyalty module enabled) -->
        <StackPanel Margin="0,0,0,24"
                    Visibility="{Binding LoyaltyEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="LOYALTY POINTS" Style="{StaticResource Text.Caption}"
                       Foreground="{DynamicResource Brush.Brand.Primary}"
                       Margin="0,24,0,12"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Current balance" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                            <TextBlock Text="{Binding LoyaltyPointsBalance, StringFormat='{}{0} points'}" Style="{StaticResource Text.H2}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="Redeemable value" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                            <TextBlock Text="{Binding LoyaltyValueDisplay}" Style="{StaticResource Text.H3}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}"/>

                    <TextBlock Text="AVAILABLE REWARDS" Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               Margin="0,0,0,12"/>

                    <ItemsControl ItemsSource="{Binding RedeemableRewards}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ValueDisplay}" Style="{StaticResource Text.Caption}"/>
                                            <TextBlock Text="{Binding PointsRequired, StringFormat='{}{0} points required'}"
                                                       Style="{StaticResource Text.Caption}"
                                                       Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Redeem"
                                                Style="{StaticResource Button.OutlineBrand}"
                                                Command="{Binding DataContext.RedeemRewardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanAfford}"
                                                Height="32" Padding="16,6" MinWidth="90"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No rewards defined yet. Add some in Loyalty → Rewards."
                               Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Text.Tertiary}"
                               Margin="0,8,0,0"
                               Visibility="{Binding RedeemableRewards.Count, Converter={StaticResource ZeroCountToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </StackPanel></StackPanel>
</UserControl>



