<Window x:Class="FitCore.Desktop.Views.Members.RecordPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record payment"
        Width="520" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Surface.Base}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Border Style="{StaticResource Card}" Margin="24">
        <StackPanel>
            <TextBlock Text="Record payment" Style="{StaticResource Text.H2}" Margin="0,0,0,20"/>

            <TextBlock Text="Amount" Style="{StaticResource Text.FieldLabel}"/>
            <TextBox Style="{StaticResource Input.TextBox}"
                     Text="{Binding AmountDisplay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,16"/>

            <TextBlock Text="Method" Style="{StaticResource Text.FieldLabel}"/>
            <ComboBox Style="{StaticResource Input.ComboBox}"
                      ItemsSource="{Binding Methods}"
                      SelectedItem="{Binding Method}"
                      ItemContainerStyle="{StaticResource Input.ComboBoxItem}"
                      Margin="0,0,0,16"/>

            <TextBlock Text="Reference (M-Pesa code, etc.)" Style="{StaticResource Text.FieldLabel}"/>
            <TextBox Style="{StaticResource Input.TextBox}"
                     Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,16"/>

            <TextBlock Text="Notes (optional)" Style="{StaticResource Text.FieldLabel}"/>
            <TextBox Style="{StaticResource Input.TextBox}"
                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                     Height="64"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     Margin="0,0,0,16"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Style="{StaticResource Text.Error}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsedConverter}}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource Button.Secondary}"
                        Command="{Binding CancelCommand}" Margin="0,0,12,0"/>
                <Button Content="Record" Style="{StaticResource Button.Primary}"
                        Command="{Binding ConfirmCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
