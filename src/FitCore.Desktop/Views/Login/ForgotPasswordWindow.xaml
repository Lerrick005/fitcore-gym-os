<Window x:Class="FitCore.Desktop.Views.Login.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:FitCore.Desktop.Views.Controls"
        Title="FitCore — Recover account"
        Height="680" Width="900"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Brush.Surface.Base}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="48,24" Background="Transparent">
            <TextBlock Text="FITCORE" Style="{StaticResource Text.Wordmark}"/>
        </Border>

        <Grid Grid.Row="1">
            <Border Style="{StaticResource Card}"
                    Width="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>

                    <TextBlock Text="Account recovery"
                               Style="{StaticResource Text.H1}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Owner-password recovery requires a signed code from your vendor."
                               Style="{StaticResource Text.Secondary}"
                               Margin="0,0,0,24"/>

                    <!-- Step 1 -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}">
                        <TextBlock Text="Step 1 — Request a challenge"
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Brand.Primary}"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Username" Style="{StaticResource Text.FieldLabel}"/>
                        <TextBox Style="{StaticResource Input.TextBox}"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16"/>

                        <Button Content="Generate challenge code"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding IssueChallengeCommand}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Step 2 -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}">
                        <TextBlock Text="Step 2 — Send challenge to vendor, paste recovery code"
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Brand.Primary}"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Challenge code" Style="{StaticResource Text.FieldLabel}"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource Input.TextBox}"
                                     Text="{Binding ChallengeCode, Mode=OneWay}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"/>
                            <Button Grid.Column="1"
                                    Content="Copy"
                                    Style="{StaticResource Button.Secondary}"
                                    Command="{Binding CopyChallengeCodeCommand}"
                                    Margin="8,0,0,0"/>
                        </Grid>

                        <TextBlock Text="Recovery code (from vendor)" Style="{StaticResource Text.FieldLabel}"/>
                        <TextBox Style="{StaticResource Input.TextBox}"
                                 Text="{Binding RecoveryCode, UpdateSourceTrigger=PropertyChanged}"
                                 Height="72"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Margin="0,0,0,16"
                                 FontFamily="Consolas"/>

                        <Button Content="Verify recovery code"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding VerifyRecoveryCommand}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Step 3 -->
                    <StackPanel Visibility="{Binding Step, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}">
                        <TextBlock Text="Step 3 — Set a new password"
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Brand.Primary}"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="New password" Style="{StaticResource Text.FieldLabel}"/>
                        <ctrl:PasswordRevealBox Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,0,0,16"/>

                        <TextBlock Text="Confirm password" Style="{StaticResource Text.FieldLabel}"/>
                        <ctrl:PasswordRevealBox Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="0,0,0,16"/>

                        <TextBlock Text="At least 10 characters, upper + lower + digit + symbol."
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                   Margin="0,0,0,16"/>

                        <Button Content="Reset password"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding CompleteRecoveryCommand}"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Info + Error messages -->
                    <TextBlock Text="{Binding InfoMessage}"
                               Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Brand.Primary}"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource Text.Error}"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>


