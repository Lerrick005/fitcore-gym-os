<Window x:Class="FitCore.Desktop.Views.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:FitCore.Desktop.Views.Controls"
        Title="FitCore — Sign in"
        Height="580" Width="900"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Brush.Surface.Base}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="48,24" Background="Transparent">
            <TextBlock Text="FITCORE" Style="{StaticResource Text.Wordmark}"/>
        </Border>

        <Grid Grid.Row="1">
            <Border Style="{StaticResource Card}"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>

                    <TextBlock Text="Welcome back"
                               Style="{StaticResource Text.H1}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Sign in to continue."
                               Style="{StaticResource Text.Secondary}"
                               Margin="0,0,0,32"/>

                    <TextBlock Text="Username" Style="{StaticResource Text.FieldLabel}"/>
                    <TextBox x:Name="UsernameBox"
                             Style="{StaticResource Input.TextBox}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>
                    <TextBlock Text="Password" Style="{StaticResource Text.FieldLabel}"/>
                    <ctrl:PasswordRevealBox Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource Text.Error}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsedConverter}}"
                               Margin="0,0,0,16"
                               TextWrapping="Wrap"/>

                    <Button Content="Sign in"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding SignInCommand}"
                            HorizontalAlignment="Stretch"
                            IsDefault="True"
                            Margin="0,0,0,12"/>

                    <Button Content="Forgot password?"
                            Style="{StaticResource Button.Text}"
                            Click="ForgotPassword_Click"
                            HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding IsBusy, Converter={StaticResource BooleanToBusyTextConverter}}"
                               Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"/>

                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="48,16" Background="Transparent">
            <TextBlock Text="{Binding AttributionText, FallbackValue='Powered by FitCore'}"
                       Style="{StaticResource Text.Caption}"
                       Foreground="{DynamicResource Brush.Text.Tertiary}"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>




