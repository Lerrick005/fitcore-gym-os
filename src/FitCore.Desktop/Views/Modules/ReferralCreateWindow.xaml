<Window x:Class="FitCore.Desktop.Views.Modules.ReferralCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create referral"
        Width="500" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Surface.Base}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Border Style="{StaticResource Card}" Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Create referral" Style="{StaticResource Text.H2}" Margin="0,0,0,20"/>

            <TextBlock Text="Referring member" Style="{StaticResource Text.FieldLabel}"/>
            <ComboBox Style="{StaticResource Input.ComboBox}"
                      ItemsSource="{Binding Members}"
                      SelectedItem="{Binding SelectedMember}"
                      DisplayMemberPath="FullName"
                      ItemContainerStyle="{StaticResource Input.ComboBoxItem}"
                      Margin="0,0,0,16"/>

            <TextBlock Text="Referral code" Style="{StaticResource Text.FieldLabel}"/>
            <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding ReferralCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Margin="0,0,0,16"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsedConverter}}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,12,0"/>
                <Button Content="Create" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>


