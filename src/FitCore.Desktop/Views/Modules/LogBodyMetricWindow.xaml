<Window x:Class="FitCore.Desktop.Views.Modules.LogBodyMetricWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Body Metric"
        Width="440" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Surface.Base}">
    <Window.Resources>
        <Style x:Key="LocalInputBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#242424"/>
            <Setter Property="CaretBrush" Value="#B94720"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8DFD0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    <Border Style="{StaticResource Card}" Margin="24" Padding="24">
        <StackPanel>
            <TextBlock Text="Log Body Metric" Style="{StaticResource Text.H2}" Margin="0,0,0,20"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Weight (kg)" Style="{StaticResource Text.FieldLabel}"/>
                    <TextBox Style="{StaticResource LocalInputBox}" Text="{Binding WeightKg, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Body Fat %" Style="{StaticResource Text.FieldLabel}"/>
                    <TextBox Style="{StaticResource LocalInputBox}" Text="{Binding BodyFatPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="Notes (optional)" Style="{StaticResource Text.FieldLabel}"/>
            <TextBox Style="{StaticResource LocalInputBox}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,4,0,16"/>
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,12,0" Padding="16,8"/>
                <Button Content="Save" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" Padding="20,8"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
