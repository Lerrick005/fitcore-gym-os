<Window x:Class="FitCore.Desktop.Views.Modules.InventoryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="520" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.Surface.Base}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Border Style="{StaticResource Card}" Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" Margin="0,0,0,20"/>

                <TextBlock Text="Item name" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Item code (optional — auto-generated if blank)" Style="{StaticResource Text.FieldLabel}"/>
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" Tag="e.g. INV-0001 (leave blank to auto-generate)"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Category" Style="{StaticResource Text.FieldLabel}"/>
                        <ComboBox Style="{StaticResource Input.ComboBox}" 
                                  ItemsSource="{Binding Categories}" 
                                  SelectedItem="{Binding SelectedCategory}"
                                  ItemContainerStyle="{StaticResource Input.ComboBoxItem}"/>
                        <TextBox Style="{StaticResource Input.TextBox}" 
                                 Text="{Binding CustomCategory, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="If Other, type custom..."
                                 Margin="0,6,0,0"
                                 Visibility="{Binding SelectedCategory, Converter={StaticResource EqualStringToVisibilityConverter}, ConverterParameter='Other'}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Stock level" Style="{StaticResource Text.FieldLabel}"/>
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding StockLevel, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Low-stock threshold" Style="{StaticResource Text.FieldLabel}"/>
                        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding LowStockThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Unit price (KSh, optional)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Margin="0,0,0,16"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsedConverter}}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,12,0"/>
                    <Button Content="Save" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>


