<Window x:Class="FitCore.Desktop.Views.Modules.StockAdjustmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adjust stock"
        Width="480" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.Surface.Base}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Border Style="{StaticResource Card}" Margin="24">
        <StackPanel>
            <TextBlock Text="Adjust stock" Style="{StaticResource Text.H2}" Margin="0,0,0,20"/>

            <TextBlock Text="{Binding ItemName, StringFormat='Item: {0}'}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding CurrentStock, StringFormat='Current stock: {0}'}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,24"/>

            <TextBlock Text="Change (positive to add, negative to remove)" Style="{StaticResource Text.FieldLabel}"/>
            <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Delta, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

            <TextBlock Text="Reason (optional)" Style="{StaticResource Text.FieldLabel}"/>
            <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,0,0,16"/>

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Margin="0,0,0,16"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsedConverter}}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,12,0"/>
                <Button Content="Adjust" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>

