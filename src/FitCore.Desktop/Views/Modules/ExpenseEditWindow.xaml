<Window x:Class="FitCore.Desktop.Views.Modules.ExpenseEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="520" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.Surface.Base}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Border Style="{StaticResource Card}" Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" Margin="0,0,0,20"/>

                <TextBlock Text="Category" Style="{StaticResource Text.FieldLabel}"/>
                <ComboBox Style="{StaticResource Input.ComboBox}" ItemsSource="{Binding FilteredCategories}"
                          SelectedItem="{Binding SelectedCategory}" ItemContainerStyle="{StaticResource Input.ComboBoxItem}"
                          Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"
                             Width="220" Margin="0,0,8,0" Tag="New category name..."/>
                    <Button Content="+ Add category" Style="{StaticResource Button.OutlineSoft}" Command="{Binding CreateCategoryCommand}" Padding="12,8"/>
                </StackPanel>

                <TextBlock Text="Amount (KSh)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding AmountInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <TextBlock Text="Date" Style="{StaticResource Text.FieldLabel}"/>
                <DatePicker SelectedDate="{Binding OccurredAt}" Margin="0,0,0,16"/>

                <TextBlock Text="Description" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,0,0,16"/>

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Margin="0,0,0,16"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsedConverter}}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,12,0"/>
                    <Button Content="Save" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>

