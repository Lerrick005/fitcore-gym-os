<Window x:Class="FitCore.Desktop.Views.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FitCore"
        Height="800" Width="1320"
        MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Surface.Base}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Width="260"
                Background="{DynamicResource Brush.Surface.Raised}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Wordmark -->
                <Border Grid.Row="0" Padding="24,28,24,24">
                    <TextBlock Text="FITCORE" Style="{StaticResource Text.Wordmark}"/>
                </Border>

                <!-- Navigation groups -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" PanningDeceleration="0.001" PanningRatio="1.5">
                    <ItemsControl ItemsSource="{Binding Groups}" Margin="12,0,12,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <!-- Group header (hidden for Main) -->
                                    <TextBlock Text="{Binding DisplayName}"
                                               Style="{StaticResource Text.Caption}"
                                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Margin="12,8,0,4"
                                               Visibility="{Binding GroupName, Converter={StaticResource NullOrEmptyToCollapsedConverter}}"/>

                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,2"
                                                        Cursor="Hand"
                                                        HorizontalContentAlignment="Stretch">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Padding" Value="0"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd"
                                                                                Background="{TemplateBinding Background}"
                                                                                CornerRadius="8"
                                                                                Padding="12,11">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <!-- Active indicator bar -->
                                                                                <Border x:Name="Indicator"
                                                                                        Grid.Column="0"
                                                                                        Width="3"
                                                                                        Height="20"
                                                                                        CornerRadius="2"
                                                                                        Background="{DynamicResource Brush.Brand.Primary}"
                                                                                        Margin="-8,0,8,0"
                                                                                        VerticalAlignment="Center"
                                                                                        Visibility="Collapsed"/>
                                                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                                    <TextBlock Text="{Binding IconGlyph}"
                                                                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                                               FontSize="16"
                                                                                               VerticalAlignment="Center"
                                                                                               Margin="0,0,12,0"
                                                                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                                                                               x:Name="Icon"/>
                                                                                    <TextBlock Text="{Binding DisplayName}"
                                                                                               FontSize="14"
                                                                                               VerticalAlignment="Center"
                                                                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                                                                               x:Name="Label"/>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                                                                            </Trigger>
                                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#FCEBE4"/>
                                                                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                                                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.Brand.Primary}"/>
                                                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Brand.Primary}"/>
                                                                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
                                                                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}"/>
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- User info + logout -->
                <Border Grid.Row="2"
                        Padding="20,20,20,20"
                        BorderBrush="{DynamicResource Brush.Border.Subtle}"   
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Avatar with initials -->
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#FCEBE4" VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock Text="LR" FontSize="14" FontWeight="Bold" Foreground="#B94720" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding UserDisplayName}"
                                       Style="{StaticResource Text.Body}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="Signed in"
                                       Style="{StaticResource Text.Caption}"       
                                       Foreground="{DynamicResource Brush.Text.Tertiary}"
                                       Margin="0,0,0,8"/>
                            <Button Content="Sign out"
                                    Style="{StaticResource Button.Text}"
                                    Command="{Binding LogoutCommand}"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    Padding="32,24"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPage.Title, FallbackValue='Dashboard'}"
                                   Style="{StaticResource Text.H3}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding CurrentPage}" Margin="32"/>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Padding="32,12"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding AttributionText}"
                               Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               VerticalAlignment="Center"
                               Visibility="{Binding ShowAttribution, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <TextBlock Grid.Column="1"
                               Text="v1.0.0"
                               Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>



