<UserControl x:Class="FitCore.Desktop.Views.Wizard.WizardShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource Brush.Surface.Base}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ProgressBar Grid.Row="0"
                     Style="{StaticResource Progress.Wizard}"
                     Minimum="0" Maximum="100"
                     Value="{Binding ProgressPercent, Mode=OneWay}"/>

        <Border Grid.Row="1" Padding="48,28,48,16" Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="FITCORE"
                           Style="{StaticResource Text.Wordmark}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentStepViewModel.Title, FallbackValue=''}"
                           Style="{StaticResource Text.Caption}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Tertiary}"/>
            </Grid>
        </Border>

        <!-- Card content: use ScrollViewer around just the card, VerticalAlignment=Top for consistency -->
        <ScrollViewer Grid.Row="2"
                      x:Name="ContentScroll"
                      Margin="48,0,48,16"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource Card}"
                    MaxWidth="760"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentStepViewModel.Title}"
                               Style="{StaticResource Text.H1}"
                               Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding CurrentStepViewModel.Description}"
                               Style="{StaticResource Text.Secondary}"
                               Margin="0,0,0,36"/>

                    <Border Style="{StaticResource Divider}"/>

                    <ContentControl Content="{Binding CurrentStepViewModel}"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="48,20,48,28" Background="Transparent">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding CurrentStepViewModel.ErrorMessage}"
                           Style="{StaticResource Text.Error}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,24,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Back"
                            Style="{StaticResource Button.Secondary}"
                            Command="{Binding BackCommand}"
                            Margin="0,0,12,0"
                            IsEnabled="{Binding CanGoBack}"/>
                    <Button Content="Continue"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding NextCommand}"
                            Visibility="{Binding IsOnLastStep, Converter={StaticResource BooleanToVisibilityInverseConverter}}"/>
                    <Button Content="Finish setup"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding FinishCommand}"
                            Visibility="{Binding IsOnLastStep, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
