<UserControl x:Class="FitCore.Desktop.Views.Wizard.Steps.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <TextBlock Text="READY TO GO" Style="{StaticResource Text.Caption}"
                   Foreground="{DynamicResource Brush.Brand.Primary}"
                   Margin="0,0,0,20"/>

        <Border Background="{DynamicResource Brush.Surface.Sunken}"
                CornerRadius="{DynamicResource Radius.Md}"
                Padding="24">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Business" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SummaryBusiness}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Currency" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SummaryCurrency}" Style="{StaticResource Text.Body}"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Time zone" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SummaryTimeZone}" Style="{StaticResource Text.Body}"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Plans" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SummaryPlans}" Style="{StaticResource Text.Body}"/>
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Text="You can change every setting later in Settings."
                   Style="{StaticResource Text.Caption}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                   Margin="0,20,0,0"/>

    </StackPanel>
</UserControl>
