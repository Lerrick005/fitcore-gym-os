<UserControl x:Class="FitCore.Desktop.Views.Wizard.Steps.RolesAndOwnerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:FitCore.Desktop.Views.Controls">
    <StackPanel>

        <TextBlock Text="OWNER ACCOUNT" Style="{StaticResource Text.Caption}"
                   Foreground="{DynamicResource Brush.Brand.Primary}"
                   Margin="0,0,0,8"/>

        <TextBlock Text="Create the account you will use to sign in. You can add more staff later."
                   Style="{StaticResource Text.Caption}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                   Margin="0,0,0,24"/>

        <TextBlock Text="Username" Style="{StaticResource Text.FieldLabel}"/>
        <TextBox Style="{StaticResource Input.TextBox}"
                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,16"/>

        <TextBlock Text="Display name" Style="{StaticResource Text.FieldLabel}"/>
        <TextBox Style="{StaticResource Input.TextBox}"
                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,16"/>

        <TextBlock Text="Password" Style="{StaticResource Text.FieldLabel}"/>
        <ctrl:PasswordRevealBox Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Margin="0,0,0,8"/>

        <TextBlock Text="At least 10 characters, including upper, lower, digit, and symbol."
                   Style="{StaticResource Text.Caption}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                   Margin="0,0,0,16"/>

        <TextBlock Text="Confirm password" Style="{StaticResource Text.FieldLabel}"/>
        <ctrl:PasswordRevealBox Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

    </StackPanel>
</UserControl>


