<UserControl x:Class="FitCore.Desktop.Views.Wizard.Steps.BusinessIdentityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <TextBlock Text="Business name" Style="{StaticResource Text.FieldLabel}"/>
        <TextBox Style="{StaticResource Input.TextBox}"
                 Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,20"/>

        <TextBlock Text="Phone number" Style="{StaticResource Text.FieldLabel}"/>
        <TextBox Style="{StaticResource Input.TextBox}"
                 Text="{Binding PhonePrimary, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,20"/>

        <TextBlock Text="Email (optional)" Style="{StaticResource Text.FieldLabel}"/>
        <TextBox Style="{StaticResource Input.TextBox}"
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,8"/>

        <TextBlock Text="You can add trading name, website, address, registration number and social handles later in Settings."
                   Style="{StaticResource Text.Caption}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                   TextWrapping="Wrap"
                   Margin="0,12,0,0"/>

    </StackPanel>
</UserControl>
