<UserControl x:Class="FitCore.Desktop.Views.Pages.LoyaltyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Loyalty &amp; Referrals" Style="{StaticResource Text.H1}" Margin="0,0,0,4"/>
                <TextBlock Text="Referral programs and member points." Style="{StaticResource Text.Secondary}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ Referral" Style="{StaticResource Button.OutlineSoft}" Command="{Binding CreateReferralCommand}" Padding="16,10" MinWidth="110" Margin="0,0,8,0"/>
                <Button Content="+ Reward" Style="{StaticResource Button.OutlineSoft}" Command="{Binding AddRewardCommand}" Padding="16,10" MinWidth="110" Margin="0,0,8,0"/>
                <Button Content="+ Points" Style="{StaticResource Button.Primary}" Command="{Binding AddEntryCommand}" Padding="20,10" MinWidth="100"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <TextBlock Text="REFERRALS" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Brand.Primary}" Margin="0,0,0,16"/>
                    <ScrollViewer MaxHeight="500">
                        <ItemsControl ItemsSource="{Binding Referrals}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ReferrerName}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ReferralCode, StringFormat='Code: {0}'}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='Referred: {0:dd/MM/yyyy}'}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <TextBlock Text="POINTS LEDGER" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Brand.Primary}" Margin="0,0,0,16"/>
                    <ScrollViewer MaxHeight="500">
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding MemberName}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Reason}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Points, StringFormat='{}{0} pts'}" Style="{StaticResource Text.Body}"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <TextBlock Text="REWARDS" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Brand.Primary}" Margin="0,0,0,16"/>
                    <ScrollViewer MaxHeight="500">
                        <ItemsControl ItemsSource="{Binding Rewards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                                                    <Run Text="{Binding PointsRequired, Mode=OneWay}"/><Run Text=" pts · "/><Run Text="{Binding RewardType, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding ValueMinor, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Edit" Style="{StaticResource Button.OutlineSoft}" Padding="10,6" MinWidth="60" VerticalAlignment="Center" Margin="16,0,0,0"
                                                    Command="{Binding DataContext.EditRewardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

