<UserControl x:Class="FitCore.Desktop.Views.Pages.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Reports" Style="{StaticResource Text.H1}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Export CSV" Style="{StaticResource Button.OutlineSoft}"
                                    Command="{Binding ExportCsvCommand}" Padding="16,8" Margin="0,0,8,0"/>
                            <Button Content="Export PDF" Style="{StaticResource Button.Primary}"
                                    Command="{Binding ExportPdfCommand}" Padding="16,8"/>
                        </StackPanel>
                    </Grid>
            <TextBlock Text="Last 30 days at a glance." Style="{StaticResource Text.Secondary}" Margin="0,0,0,24"/>

            <!-- Top stats -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="REVENUE (30D)" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding RevenueLast30DaysDisplay}" Style="{StaticResource Text.H2}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="NEW MEMBERS (30D)" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding NewMembersLast30Days}" Style="{StaticResource Text.H2}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="ACTIVE MEMBERS" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ActiveMembers}" Style="{StaticResource Text.H2}"/>
                    </StackPanel>
                </Border>
            </Grid>

            
            <!-- Charts row 1: Daily revenue + Member growth -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="REVENUE — LAST 30 DAYS" Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding RevenueLast30DaysDisplay}" Style="{StaticResource Text.H3}" Margin="0,0,0,12"/>
                        <lvc:CartesianChart Series="{Binding RevenueChartSeries}"
                                            XAxes="{Binding RevenueChartXAxes}"
                                            YAxes="{Binding RevenueChartYAxes}"
                                            Height="200"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="NEW MEMBERS — LAST 30 DAYS" Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding MembersThisMonthDelta}" Style="{StaticResource Text.H3}" Margin="0,0,0,12"/>
                        <lvc:CartesianChart Series="{Binding GrowthChartSeries}"
                                            XAxes="{Binding GrowthChartXAxes}"
                                            YAxes="{Binding GrowthChartYAxes}"
                                            Height="200"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Charts row 2: Monthly revenue + delta cards -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="MONTHLY REVENUE — LAST 12 MONTHS" Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,12"/>
                        <lvc:CartesianChart Series="{Binding MonthlyRevenueChartSeries}"
                                            XAxes="{Binding MonthlyRevenueChartXAxes}"
                                            YAxes="{Binding MonthlyRevenueChartYAxes}"
                                            Height="240"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="THIS MONTH" Style="{StaticResource Text.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                            <TextBlock Text="{Binding RevenueThisMonthDisplay}" Style="{StaticResource Text.H2}" Margin="0,4,0,4"/>
                            <TextBlock Text="{Binding RevenueMonthlyDelta}"
                                       Foreground="{DynamicResource Brush.Semantic.Success}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Semantic.Danger}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RevenueIsUp}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Semantic.Success}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="YEAR TO DATE" Style="{StaticResource Text.Caption}"
                                       Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                            <TextBlock Text="{Binding RevenueYtdDisplay}" Style="{StaticResource Text.H2}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Revenue by method -->
            <TextBlock Text="REVENUE BY METHOD" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Brand.Primary}" Margin="0,0,0,12"/>
            <Border Background="{DynamicResource Brush.Surface.Raised}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Md}" Margin="0,0,0,24">
                <ItemsControl ItemsSource="{Binding RevenueByMethodRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="20,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Method}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat='{}{0} payments'}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,24,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding AmountDisplay}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Expiring soon -->
            <TextBlock Text="EXPIRING IN 30 DAYS" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Brand.Primary}" Margin="0,0,0,12"/>
            <Border Background="{DynamicResource Brush.Surface.Raised}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Md}">
                <ItemsControl ItemsSource="{Binding ExpiringRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="20,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding FullName}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding MemberNumber}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PlanName}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding EndDateDisplay}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>


