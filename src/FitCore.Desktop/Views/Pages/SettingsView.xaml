<UserControl x:Class="FitCore.Desktop.Views.Pages.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>

            <!-- Landing: clean 2-column card grid -->
            <StackPanel Margin="0,0,0,0"
                        Visibility="{Binding IsOnLanding, Converter={StaticResource BooleanToVisibilityConverter}}">

                <TextBlock Text="Settings" Style="{StaticResource Text.H1}" Margin="0,0,0,8"/>
                <TextBlock Text="Everything about your gym can be changed here. Changes apply immediately."
                           Style="{StaticResource Text.Secondary}" Margin="0,0,0,32"/>

                <ItemsControl ItemsSource="{Binding Landing.Sections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Button.Text}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Padding="0"
                                    Margin="0,0,16,16"
                                    Cursor="Hand"
                                    Command="{Binding DataContext.Landing.OpenSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Border Background="{DynamicResource Brush.Surface.Raised}"
                                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Lg}"
                                        Padding="24,20"
                                        Effect="{DynamicResource Shadow.Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="48" Height="48"
                                                CornerRadius="12"
                                                Background="{DynamicResource Brush.Surface.Sunken}"
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IconGlyph}"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="22"
                                                       Foreground="{DynamicResource Brush.Brand.Primary}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource Text.H3}"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Style="{StaticResource Text.Caption}"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="›"
                                                   FontSize="28"
                                                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>

            <!-- Detail: single section -->
            <StackPanel Visibility="{Binding IsOnLanding, Converter={StaticResource BooleanToVisibilityInverseConverter}}">
                <Button Content="← Back to settings"
                        Style="{StaticResource Button.Text}"
                        Command="{Binding BackToLandingCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,20"/>

                <TextBlock Text="{Binding Current.GroupName}"
                           Style="{StaticResource Text.H1}"
                           Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Current.GroupDescription}"
                           Style="{StaticResource Text.Secondary}"
                           Margin="0,0,0,24"/>

                <!-- Detail content — the section VM's template handles rendering -->
                <ContentControl Content="{Binding Current}"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
