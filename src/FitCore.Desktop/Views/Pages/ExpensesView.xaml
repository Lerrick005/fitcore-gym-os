<UserControl x:Class="FitCore.Desktop.Views.Pages.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Expenses" Style="{StaticResource Text.H1}" Margin="0,0,0,4"/>
                <TextBlock Text="Track business expenses by category." Style="{StaticResource Text.Secondary}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ Category" Style="{StaticResource Button.OutlineSoft}" Command="{Binding AddCategoryCommand}" Padding="16,10" MinWidth="110" Margin="0,0,8,0"/>
                <Button Content="+ Expense" Style="{StaticResource Button.Primary}" Command="{Binding AddExpenseCommand}" Padding="20,10" MinWidth="120"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="TOTAL (3 MONTHS)" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                <TextBlock Text="{Binding TotalDisplay}" Style="{StaticResource Text.H2}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Raised}" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Md}">
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource Brush.Border.Subtle}"
                      BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                      AlternatingRowBackground="{DynamicResource Brush.Surface.Sunken}" RowHeight="48">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="16,12"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="16,10"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding OccurredDisplay}" Width="*" MinWidth="130"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="1.5*" MinWidth="150"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" MinWidth="200"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding AmountDisplay}" Width="*" MinWidth="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
