<UserControl x:Class="FitCore.Desktop.Views.Pages.ClassAttendeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Classes &gt; Attendees" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ClassName}" Style="{StaticResource Text.H1}" FontSize="28"/>
                    <TextBlock Text="{Binding ClassSchedule}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="+ Book Member" Style="{StaticResource Button.Primary}" 
                        Command="{Binding AddAttendeeCommand}" Padding="20,10" MinWidth="140" VerticalAlignment="Bottom"/>
            </Grid>

            <!-- STATS -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="CAPACITY" Style="{StaticResource Text.Caption}" Foreground="#777777" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Capacity}" FontSize="32" FontWeight="Bold" Foreground="#242424"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="BOOKED" Style="{StaticResource Text.Caption}" Foreground="#777777" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding BookedCount}" FontSize="32" FontWeight="Bold" Foreground="#B94720"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="ATTENDED" Style="{StaticResource Text.Caption}" Foreground="#777777" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding AttendedCount}" FontSize="32" FontWeight="Bold" Foreground="#18865B"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ATTENDEES LIST -->
            <Border Grid.Row="2" Style="{StaticResource Card.Premium}">
                <StackPanel>
                    <TextBlock Text="Attendee Roster" FontSize="18" FontWeight="Bold" Foreground="#242424" Margin="0,0,0,16"/>

                    <ItemsControl ItemsSource="{Binding Attendees}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EAEAEA" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding MemberName}" FontWeight="SemiBold" FontSize="14" Foreground="#242424"/>
                                            <TextBlock Text="{Binding Phone}" FontSize="12" Foreground="#777777" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding BookedAtUtc, StringFormat='Booked: {0:dd/MM/yyyy HH:mm}'}" FontSize="11" Foreground="#999999" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="#FCEBE4" CornerRadius="12" Padding="10,4" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#B94720" FontWeight="SemiBold"/>
                                        </Border>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <Button Content="Check In" Style="{StaticResource Button.OutlineSoft}" Padding="10,6" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.CheckInCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="No Show" Style="{StaticResource Button.OutlineSoft}" Padding="10,6" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.MarkNoShowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Cancel" Style="{StaticResource Button.OutlineSoft}" Padding="10,6"
                                                    Command="{Binding DataContext.CancelBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
