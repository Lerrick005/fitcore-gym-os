<UserControl x:Class="FitCore.Desktop.Views.Pages.ClassesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Background="Transparent">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Management &gt; Classes &amp; Programs" Style="{StaticResource Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="Classes &amp; Programs" Style="{StaticResource Text.H1}" FontSize="28"/>
                    <TextBlock Text="Weekly class schedule." Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="+ Add class" Style="{StaticResource Button.Primary}" 
                        Command="{Binding AddClassCommand}" Padding="20,10" MinWidth="120" VerticalAlignment="Bottom"/>
            </Grid>

            <!-- STATS ROW -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="TOTAL CLASSES" Style="{StaticResource Text.Caption}" Foreground="#777777" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Classes.Count}" FontSize="32" FontWeight="Bold" Foreground="#242424"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="ACTIVE BOOKINGS" Style="{StaticResource Text.Caption}" Foreground="#777777" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Bookings.Count}" FontSize="32" FontWeight="Bold" Foreground="#B94720"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource StatCard}">
                    <StackPanel>
                        <TextBlock Text="CAPACITY" Style="{StaticResource Text.Caption}" Foreground="#777777" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="N/A" FontSize="32" FontWeight="Bold" Foreground="#18865B"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- CALENDAR GRID (Made Taller) -->
            <Border Grid.Row="2" Style="{StaticResource Card.Premium}" MinHeight="400">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Weekly Schedule" FontSize="18" FontWeight="Bold" Foreground="#242424" Margin="0,0,0,16"/>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ClassesByDay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EAEAEA" BorderThickness="0,0,1,0" Padding="8,0" Margin="0,0,4,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Day header -->
                                        <Border Grid.Row="0" Background="#F7F4EE" CornerRadius="6" Padding="8,8" Margin="0,0,0,12">
                                            <TextBlock Text="{Binding DayName}" FontWeight="Bold" FontSize="13" Foreground="#242424" HorizontalAlignment="Center"/>
                                        </Border>
                                        
                                        <!-- Classes for the day -->
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Classes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#FCEBE4" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="#242424" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding StartTime, StringFormat='{}{0:HH:mm}'}" FontSize="11" Foreground="#B94720" Margin="0,2,0,0" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding DurationMinutes, StringFormat='{}{0} min'}" FontSize="10" Foreground="#888888" Margin="0,1,0,0"/>
                                                                <Border Background="#B94720" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="0,6,0,0">
                                                                    <TextBlock Text="{Binding BookedCount, StringFormat='{}{0} booked'}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                                                </Border>
                                                                <Button Content="Book" Style="{StaticResource Button.OutlineSoft}" 
                                                                        Command="{Binding DataContext.BookMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Margin="0,8,0,0" Padding="8,4" HorizontalAlignment="Stretch"/>
                                                                <Button Content="Manage" Style="{StaticResource Button.OutlineSoft}"
                                                                        Command="{Binding DataContext.ManageAttendeesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Margin="0,4,0,0" Padding="8,4" HorizontalAlignment="Stretch"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- UNSCHEDULED CLASSES (If any exist) -->
            <Border Grid.Row="3" Style="{StaticResource Card.Premium}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Unscheduled Classes" FontSize="16" FontWeight="Bold" Foreground="#242424" Margin="0,0,0,4"/>
                    <TextBlock Text="These classes do not have a day or time yet, so they won't appear on the calendar." FontSize="12" Foreground="#777777" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Unscheduled}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EAEAEA" BorderThickness="0,0,0,1" Padding="0,8">
                                    <TextBlock Text="{Binding Name}" FontSize="14" Foreground="#242424" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>



