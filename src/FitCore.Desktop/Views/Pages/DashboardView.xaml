<UserControl x:Class="FitCore.Desktop.Views.Pages.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Background="Transparent">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER SECTION (No buttons, purely informational) -->
            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="Main &gt; Dashboard" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="12" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Greeting}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                <TextBlock Text="Here's what's happening today." Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- STAT CARDS ROW 1 -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Active Members -->
                <Border Grid.Column="0" Style="{StaticResource Card.Premium}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="#FDF2EF" Width="48" Height="48" CornerRadius="12" Margin="0,0,16,0">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="#B94720" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="ACTIVE MEMBERS" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ActiveMembers}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <TextBlock Text="{Binding TotalMembers, StringFormat='of {0} total'}" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Check-ins -->
                <Border Grid.Column="2" Style="{StaticResource Card.Premium}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="#F0F7FF" Width="48" Height="48" CornerRadius="12" Margin="0,0,16,0">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="#0078D4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="TODAY'S CHECK-INS" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TodayCheckIns}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <TextBlock Text="Total visits" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Revenue -->
                <Border Grid.Column="4" Style="{StaticResource Card.Premium}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="#F0FDF4" Width="48" Height="48" CornerRadius="12" Margin="0,0,16,0">
                            <TextBlock Text="&#xE8C7;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="#18865B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="REVENUE TODAY" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TodayRevenueDisplay}" FontSize="24" FontWeight="Bold" Foreground="#18865B"/>
                            <TextBlock Text="Completed payments" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- STAT CARDS ROW 2 -->
            <Grid Grid.Row="2" Margin="0,0,0,32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Expiring Soon -->
                <Border Grid.Column="0" Style="{StaticResource Card.Premium}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="#FFF8F0" Width="48" Height="48" CornerRadius="12" Margin="0,0,16,0">
                            <TextBlock Text="&#xE823;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="#B45309" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="EXPIRING SOON" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ExpiringSoon}" FontSize="28" FontWeight="Bold" Foreground="#B45309"/>
                            <TextBlock Text="Within reminder window" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Expired -->
                <Border Grid.Column="2" Style="{StaticResource Card.Premium}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="#FEF2F2" Width="48" Height="48" CornerRadius="12" Margin="0,0,16,0">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="#D13B35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="EXPIRED" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Expired}" FontSize="28" FontWeight="Bold" Foreground="#D13B35"/>
                            <TextBlock Text="Need renewal" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Outstanding -->
                <Border Grid.Column="4" Style="{StaticResource Card.Premium}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="#FFFBEB" Width="48" Height="48" CornerRadius="12" Margin="0,0,16,0">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="#B94720" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="OUTSTANDING" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Outstanding}" FontSize="28" FontWeight="Bold" Foreground="#B94720"/>
                            <TextBlock Text="Unpaid memberships" Foreground="{DynamicResource Brush.Text.Tertiary}" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- BOTTOM SECTION: FULL WIDTH ACTIVITY FEED -->
            <Border Grid.Row="3" Style="{StaticResource Card.Premium}">
                <StackPanel>
                    <TextBlock Text="Recent Activity" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Primary}" Margin="0,0,0,16"/>
                    
                    <!-- Empty State -->
                    <Border Padding="32" Background="{DynamicResource Brush.Surface.Sunken}" CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" FontSize="32" Foreground="{DynamicResource Brush.Text.Tertiary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="No recent activity yet" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Check-ins and payments will appear here." FontSize="13" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</UserControl>
