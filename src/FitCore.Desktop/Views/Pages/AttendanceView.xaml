<UserControl x:Class="FitCore.Desktop.Views.Pages.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Attendance" Style="{StaticResource Text.H1}" Margin="0,0,0,4"/>
                <TextBlock Text="Recent check-ins and quick check-in by member." Style="{StaticResource Text.Secondary}"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,12" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="TODAY" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                    <TextBlock Text="{Binding TodayCount}" Style="{StaticResource Text.H2}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Style="{StaticResource Input.TextBox}"
                         Text="{Binding MemberSearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Member name or number..."
                         Margin="0,0,12,0"/>
                <Button Grid.Column="1"
                        Content="Check in"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding CheckInBySearchCommand}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource Brush.Surface.Raised}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Md}">
            <Grid>
                <DataGrid ItemsSource="{Binding Results}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource Brush.Border.Subtle}"
                          BorderThickness="0"
                          Background="Transparent"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource Brush.Surface.Sunken}">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Check-in" Binding="{Binding CheckInDisplay}" Width="180"/>
                        <DataGridTextColumn Header="Member" Binding="{Binding MemberName}" Width="*"/>
                        <DataGridTextColumn Header="Number" Binding="{Binding MemberNumber}" Width="120"/>
                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="140"/>
                        <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HasResults, Converter={StaticResource BooleanToVisibilityInverseConverter}}">
                    <TextBlock Text="No check-ins yet." Style="{StaticResource Text.H3}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Check-ins appear here as members arrive."
                               Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
