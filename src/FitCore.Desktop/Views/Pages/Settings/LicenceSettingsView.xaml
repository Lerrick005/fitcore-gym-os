<UserControl x:Class="FitCore.Desktop.Views.Pages.Settings.LicenceSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,20">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="LICENCE STATE" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding State}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Brand.Primary}"/>
                </Grid>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Customer" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
            <TextBlock Grid.Column="1" Text="{Binding CustomerName}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
        </Grid>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Edition" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
            <TextBlock Grid.Column="1" Text="{Binding EditionLabel}" Style="{StaticResource Text.Body}"/>
        </Grid>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Installation ID" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
            <TextBlock Grid.Column="1" Text="{Binding InstallationId}" Style="{StaticResource Text.Body}" FontFamily="Consolas"/>
        </Grid>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Expires" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
            <TextBlock Grid.Column="1" Text="{Binding ExpiresDisplay}" Style="{StaticResource Text.Body}"/>
        </Grid>

        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Entitled modules" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}"/>
            <TextBlock Grid.Column="1" Text="{Binding ModulesDisplay}" Style="{StaticResource Text.Body}"/>
        </Grid>

        <Border Style="{StaticResource Divider}"/>

        <StackPanel Orientation="Horizontal">
            <Button Content="Load licence file..." Style="{StaticResource Button.OutlineBrand}" Command="{Binding LoadLicenceFileCommand}" Padding="16,8" Margin="0,0,12,0"/>
            <TextBlock Text="{Binding StatusMessageLocal}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
        </StackPanel>

    </StackPanel>
</UserControl>
