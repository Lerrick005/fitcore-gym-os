<UserControl x:Class="FitCore.Desktop.Views.Pages.Settings.BusinessSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <TextBlock Text="CONTACT" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Brand.Primary}" Margin="0,0,0,16"/>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Primary phone" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding PhonePrimary, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Secondary phone" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding PhoneSecondary, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Email" Style="{StaticResource Text.FieldLabel}"/>
        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

        <TextBlock Text="Website" Style="{StaticResource Text.FieldLabel}"/>
        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

        <TextBlock Text="Physical address" Style="{StaticResource Text.FieldLabel}"/>
        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding PhysicalAddress, UpdateSourceTrigger=PropertyChanged}" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Margin="0,0,0,16"/>

        <TextBlock Text="Social handles" Style="{StaticResource Text.FieldLabel}"/>
        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding SocialHandles, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,24"/>

        <Border Style="{StaticResource Divider}"/>

        <TextBlock Text="LEGAL" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Brand.Primary}" Margin="0,0,0,16"/>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Registration number" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding RegistrationNumber, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Tax number (e.g. KRA PIN)" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding TaxNumber, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Divider}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Save business info" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}"/>
        </StackPanel>

    </StackPanel>
</UserControl>
