<UserControl x:Class="FitCore.Desktop.Views.Pages.Settings.PlansSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Plans" Style="{StaticResource Text.H1}" Margin="0,0,0,4"/>
                <TextBlock Text="The plans and services you sell. Edit prices, add custom plans, or archive what you no longer offer."
                           Style="{StaticResource Text.Secondary}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+ Add plan"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding AddNewCommand}"
                    VerticalAlignment="Center"/>
        </Grid>

        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="{Binding DisplayName}"
                                   Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Brand.Primary}"
                                   Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding Plans}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.Surface.Raised}"
                                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Radius.Md}"
                                            Padding="16,14"
                                            Margin="0,0,12,12"
                                            Width="230">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding PriceDisplay}" Style="{StaticResource Text.H3}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding DurationDisplay}" Style="{StaticResource Text.Caption}"
                                                       Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,12"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Edit"
                                                        Style="{StaticResource Button.Text}"
                                                        Command="{Binding DataContext.EditPlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,4,0"/>
                                                <Button Content="Archive"
                                                        Style="{StaticResource Button.Text}"
                                                        Foreground="{DynamicResource Brush.Semantic.Danger}"
                                                        Command="{Binding DataContext.ArchivePlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
