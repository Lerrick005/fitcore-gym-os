<UserControl x:Class="FitCore.Desktop.Views.Pages.Settings.ModulesSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Modules" Style="{StaticResource Text.H1}" Margin="0,0,0,4"/>
        <TextBlock Text="Turn optional modules on or off. Some modules depend on others."
                   Style="{StaticResource Text.Secondary}" Margin="0,0,0,20"/>

        <ItemsControl ItemsSource="{Binding Modules}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Brush.Surface.Raised}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Md}"
                            Padding="20,16"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" Style="{StaticResource Input.CheckBox}"
                                      VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Text.H3}"/>
                                <TextBlock Text="{Binding DependenciesText}" Style="{StaticResource Text.Caption}"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}"
                   Foreground="{DynamicResource Brush.Semantic.Success}" Margin="0,12,0,0"/>

    </StackPanel>
</UserControl>
