<UserControl x:Class="FitCore.Desktop.Views.Pages.Settings.BrandingSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <TextBlock Text="IDENTITY" Style="{StaticResource Text.Caption}"
                   Foreground="{DynamicResource Brush.Brand.Primary}"
                   Margin="0,0,0,16"/>

        <TextBlock Text="Business name" Style="{StaticResource Text.FieldLabel}"/>
        <TextBox Style="{StaticResource Input.TextBox}"
                 Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,16"/>

        <TextBlock Text="Trading name (optional)" Style="{StaticResource Text.FieldLabel}"/>
        <TextBox Style="{StaticResource Input.TextBox}"
                 Text="{Binding TradingName, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,16"/>

        <TextBlock Text="Tagline (optional)" Style="{StaticResource Text.FieldLabel}"/>
        <TextBox Style="{StaticResource Input.TextBox}"
                 Text="{Binding Tagline, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,24"/>

        <Border Style="{StaticResource Divider}"/>

        <TextBlock Text="COLORS" Style="{StaticResource Text.Caption}"
                   Foreground="{DynamicResource Brush.Brand.Primary}"
                   Margin="0,0,0,16"/>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Primary" Style="{StaticResource Text.FieldLabel}"/>
                <Border Height="56" CornerRadius="{DynamicResource Radius.Md}"
                        Background="{Binding PrimaryColor}"
                        BorderBrush="{DynamicResource Brush.Border.Strong}"
                        BorderThickness="1"
                        Margin="0,0,0,8"/>
                <TextBox Style="{StaticResource Input.TextBox}"
                         Text="{Binding PrimaryColor, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Secondary" Style="{StaticResource Text.FieldLabel}"/>
                <Border Height="56" CornerRadius="{DynamicResource Radius.Md}"
                        Background="{Binding SecondaryColor}"
                        BorderBrush="{DynamicResource Brush.Border.Strong}"
                        BorderThickness="1"
                        Margin="0,0,0,8"/>
                <TextBox Style="{StaticResource Input.TextBox}"
                         Text="{Binding SecondaryColor, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Column="4">
                <TextBlock Text="Accent" Style="{StaticResource Text.FieldLabel}"/>
                <Border Height="56" CornerRadius="{DynamicResource Radius.Md}"
                        Background="{Binding AccentColor}"
                        BorderBrush="{DynamicResource Brush.Border.Strong}"
                        BorderThickness="1"
                        Margin="0,0,0,8"/>
                <TextBox Style="{StaticResource Input.TextBox}"
                         Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding ContrastWarning}"
                   Style="{StaticResource Text.Caption}"
                   Foreground="{DynamicResource Brush.Semantic.Warning}"
                   Visibility="{Binding HasContrastWarning, Converter={StaticResource BooleanToVisibilityConverter}}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,24"/>

        <Border Style="{StaticResource Divider}"/>

        <TextBlock Text="LOGO" Style="{StaticResource Text.Caption}"
                   Foreground="{DynamicResource Brush.Brand.Primary}"
                   Margin="0,0,0,16"/>

        <TextBlock Text="Light logo path (optional)" Style="{StaticResource Text.FieldLabel}"/>
        <TextBox Style="{StaticResource Input.TextBox}"
                 Text="{Binding LogoLightPath, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,16"/>

        <TextBlock Text="Dark logo path (optional)" Style="{StaticResource Text.FieldLabel}"/>
        <TextBox Style="{StaticResource Input.TextBox}"
                 Text="{Binding LogoDarkPath, UpdateSourceTrigger=PropertyChanged}"
                 Margin="0,0,0,16"/>

        <TextBlock Text="File upload comes in a future update. For now, type a full path or leave empty — the app renders correctly without a logo."
                   Style="{StaticResource Text.Caption}"
                   Foreground="{DynamicResource Brush.Text.Tertiary}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,24"/>

        <Border Style="{StaticResource Divider}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource Text.Caption}"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>
            <Button Content="Save branding" Style="{StaticResource Button.Primary}"
                    Command="{Binding SaveCommand}" />
        </StackPanel>

    </StackPanel>
</UserControl>
