<UserControl x:Class="FitCore.Desktop.Views.Pages.Settings.LocaleSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <TextBlock Text="CURRENCY" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Brand.Primary}" Margin="0,0,0,16"/>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Currency code" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="3"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Symbol" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding CurrencySymbol, UpdateSourceTrigger=PropertyChanged}" MaxLength="5"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Decimals" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding DecimalPlaces, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <CheckBox Content="Show symbol before amount" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding SymbolBeforeAmount}" Margin="0,0,0,16"/>

        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Thousands separator" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding ThousandsSeparator, UpdateSourceTrigger=PropertyChanged}" MaxLength="1"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Decimal separator" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding DecimalSeparator, UpdateSourceTrigger=PropertyChanged}" MaxLength="1"/>
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Divider}"/>

        <TextBlock Text="TIME &amp; DATE" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Brand.Primary}" Margin="0,0,0,16"/>

        <TextBlock Text="Time zone (e.g. Africa/Nairobi)" Style="{StaticResource Text.FieldLabel}"/>
        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding TimeZoneId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Date format" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding DateFormat, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Time format" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding TimeFormat, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="First day of week (0 = Sunday, 1 = Monday)" Style="{StaticResource Text.FieldLabel}"/>
        <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding FirstDayOfWeek, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,24"/>

        <Border Style="{StaticResource Divider}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Save locale" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}"/>
        </StackPanel>

    </StackPanel>
</UserControl>

