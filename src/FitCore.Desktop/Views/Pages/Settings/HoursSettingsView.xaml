<UserControl x:Class="FitCore.Desktop.Views.Pages.Settings.HoursSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <TextBlock Text="WEEKLY SCHEDULE" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Brand.Primary}" Margin="0,0,0,16"/>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Monday.DayName}" Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="1" Content="Closed" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding Monday.IsClosed}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="2" Style="{StaticResource Input.TextBox}" Text="{Binding Monday.OpenTime, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Monday.IsClosed, Converter={StaticResource BooleanToBooleanInverseConverter}}"/>
            <TextBlock Grid.Column="3" Text="to" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextAlignment="Center"/>
            <TextBox Grid.Column="4" Style="{StaticResource Input.TextBox}" Text="{Binding Monday.CloseTime, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Monday.IsClosed, Converter={StaticResource BooleanToBooleanInverseConverter}}"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Tuesday.DayName}" Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="1" Content="Closed" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding Tuesday.IsClosed}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="2" Style="{StaticResource Input.TextBox}" Text="{Binding Tuesday.OpenTime, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Tuesday.IsClosed, Converter={StaticResource BooleanToBooleanInverseConverter}}"/>
            <TextBlock Grid.Column="3" Text="to" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextAlignment="Center"/>
            <TextBox Grid.Column="4" Style="{StaticResource Input.TextBox}" Text="{Binding Tuesday.CloseTime, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Tuesday.IsClosed, Converter={StaticResource BooleanToBooleanInverseConverter}}"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Wednesday.DayName}" Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="1" Content="Closed" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding Wednesday.IsClosed}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="2" Style="{StaticResource Input.TextBox}" Text="{Binding Wednesday.OpenTime, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Wednesday.IsClosed, Converter={StaticResource BooleanToBooleanInverseConverter}}"/>
            <TextBlock Grid.Column="3" Text="to" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextAlignment="Center"/>
            <TextBox Grid.Column="4" Style="{StaticResource Input.TextBox}" Text="{Binding Wednesday.CloseTime, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Wednesday.IsClosed, Converter={StaticResource BooleanToBooleanInverseConverter}}"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Thursday.DayName}" Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="1" Content="Closed" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding Thursday.IsClosed}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="2" Style="{StaticResource Input.TextBox}" Text="{Binding Thursday.OpenTime, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Thursday.IsClosed, Converter={StaticResource BooleanToBooleanInverseConverter}}"/>
            <TextBlock Grid.Column="3" Text="to" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextAlignment="Center"/>
            <TextBox Grid.Column="4" Style="{StaticResource Input.TextBox}" Text="{Binding Thursday.CloseTime, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Thursday.IsClosed, Converter={StaticResource BooleanToBooleanInverseConverter}}"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Friday.DayName}" Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="1" Content="Closed" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding Friday.IsClosed}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="2" Style="{StaticResource Input.TextBox}" Text="{Binding Friday.OpenTime, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Friday.IsClosed, Converter={StaticResource BooleanToBooleanInverseConverter}}"/>
            <TextBlock Grid.Column="3" Text="to" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextAlignment="Center"/>
            <TextBox Grid.Column="4" Style="{StaticResource Input.TextBox}" Text="{Binding Friday.CloseTime, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Friday.IsClosed, Converter={StaticResource BooleanToBooleanInverseConverter}}"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Saturday.DayName}" Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="1" Content="Closed" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding Saturday.IsClosed}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="2" Style="{StaticResource Input.TextBox}" Text="{Binding Saturday.OpenTime, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Saturday.IsClosed, Converter={StaticResource BooleanToBooleanInverseConverter}}"/>
            <TextBlock Grid.Column="3" Text="to" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextAlignment="Center"/>
            <TextBox Grid.Column="4" Style="{StaticResource Input.TextBox}" Text="{Binding Saturday.CloseTime, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Saturday.IsClosed, Converter={StaticResource BooleanToBooleanInverseConverter}}"/>
        </Grid>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Sunday.DayName}" Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="1" Content="Closed" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding Sunday.IsClosed}" VerticalAlignment="Center"/>
            <TextBox Grid.Column="2" Style="{StaticResource Input.TextBox}" Text="{Binding Sunday.OpenTime, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Sunday.IsClosed, Converter={StaticResource BooleanToBooleanInverseConverter}}"/>
            <TextBlock Grid.Column="3" Text="to" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" TextAlignment="Center"/>
            <TextBox Grid.Column="4" Style="{StaticResource Input.TextBox}" Text="{Binding Sunday.CloseTime, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Sunday.IsClosed, Converter={StaticResource BooleanToBooleanInverseConverter}}"/>
        </Grid>

        <Border Style="{StaticResource Divider}"/>

        <TextBlock Text="POLICY" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Brand.Primary}" Margin="0,0,0,12"/>

        <CheckBox Content="Warn when check-in occurs outside hours" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding WarnOutsideHours}"/>
        <CheckBox Content="Block check-in outside hours" Style="{StaticResource Input.CheckBox}" IsChecked="{Binding BlockOutsideHours}" Margin="0,0,0,20"/>

        <Border Style="{StaticResource Divider}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Save hours" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}"/>
        </StackPanel>

    </StackPanel>
</UserControl>
