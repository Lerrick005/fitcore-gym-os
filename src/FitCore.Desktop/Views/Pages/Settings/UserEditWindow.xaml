<Window x:Class="FitCore.Desktop.Views.Pages.Settings.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="500" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.Surface.Base}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Border Style="{StaticResource Card}" Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H2}" Margin="0,0,0,20"/>

                <TextBlock Text="Username" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityInverseConverter}}" Margin="0,0,0,16"/>
                <!-- Note: WPF doesn't have an enabled inverse; using read-only approach below -->

                <TextBlock Text="Display name" Style="{StaticResource Text.FieldLabel}"/>
                <TextBox Style="{StaticResource Input.TextBox}" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                <TextBlock Text="Role" Style="{StaticResource Text.FieldLabel}"/>
                <ComboBox Style="{StaticResource Input.ComboBox}" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" ItemContainerStyle="{StaticResource Input.ComboBoxItem}" Margin="0,0,0,16"/>

                <TextBlock Text="Password (leave empty to keep current)" Style="{StaticResource Text.FieldLabel}"/>
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource Input.PasswordBox}" PasswordChanged="PasswordBox_PasswordChanged" Margin="0,0,0,16"/>

                <TextBlock Text="Confirm password" Style="{StaticResource Text.FieldLabel}"/>
                <PasswordBox x:Name="ConfirmBox" Style="{StaticResource Input.PasswordBox}" PasswordChanged="ConfirmBox_PasswordChanged" Margin="0,0,0,16"/>

                <TextBlock Text="At least 10 characters, upper + lower + digit + symbol."
                           Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,0,0,16"/>

                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Margin="0,0,0,16"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToCollapsedConverter}}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" Margin="0,0,12,0"/>
                    <Button Content="Save" Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
