<UserControl x:Class="FitCore.Desktop.Views.Pages.Settings.BackupSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>

        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Create a backup" Style="{StaticResource Text.H3}" Margin="0,0,0,4"/>
                    <TextBlock Text="Saves a copy of the whole database to the backup folder."
                               Style="{StaticResource Text.Secondary}"/>
                    <TextBlock Text="{Binding BackupFolder}" Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Back up now"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding CreateBackupCommand}"
                        VerticalAlignment="Center" Padding="16,10"/>
            </Grid>
        </Border>

        <TextBlock Text="EXISTING BACKUPS" Style="{StaticResource Text.Caption}"
                   Foreground="{DynamicResource Brush.Brand.Primary}" Margin="0,0,0,12"/>

        <Border Background="{DynamicResource Brush.Surface.Raised}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1" CornerRadius="{DynamicResource Radius.Md}">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="20,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding FileName}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding CreatedDisplay}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Tertiary}" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Content="Restore"
                                        Style="{StaticResource Button.OutlineDanger}"
                                        Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="12,6"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}"
                   Foreground="{DynamicResource Brush.Semantic.Success}"
                   Margin="0,16,0,0"/>

        <TextBlock Text="⚠  Restoring replaces the current database. A safety backup is taken automatically first."
                   Style="{StaticResource Text.Caption}"
                   Foreground="{DynamicResource Brush.Semantic.Warning}"
                   Margin="0,16,0,0" TextWrapping="Wrap"/>

    </StackPanel>
</UserControl>
