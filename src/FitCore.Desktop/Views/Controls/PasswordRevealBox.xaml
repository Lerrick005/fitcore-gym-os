<UserControl x:Class="FitCore.Desktop.Views.Controls.PasswordRevealBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <PasswordBox x:Name="MaskedInput"
                         Style="{StaticResource Input.PasswordBox}"
                         Visibility="{Binding IsRevealed, ElementName=Self, Converter={StaticResource BooleanToVisibilityInverseConverter}}"
                         PasswordChanged="MaskedInput_PasswordChanged"/>
            <TextBox x:Name="RevealedInput"
                     Style="{StaticResource Input.TextBox}"
                     Visibility="{Binding IsRevealed, ElementName=Self, Converter={StaticResource BooleanToVisibilityConverter}}"
                     TextChanged="RevealedInput_TextChanged"
                     Padding="14,11"/>
        </Grid>

        <Button Grid.Column="1"
                Width="36"
                Height="36"
                Margin="8,0,0,0"
                Style="{StaticResource Button.Text}"
                VerticalAlignment="Center"
                Cursor="Hand"
                Click="ToggleReveal_Click"
                ToolTip="Show / hide password">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" CornerRadius="6" Padding="6">
                        <TextBlock x:Name="Glyph"
                                   Text="&#xE7B3;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
