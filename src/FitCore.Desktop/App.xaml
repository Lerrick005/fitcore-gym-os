<Application x:Class="FitCore.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FitCore.Desktop.Views.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.xaml"/>
                <ResourceDictionary Source="Themes/Fonts.xaml"/>
                <ResourceDictionary Source="Themes/Typography.xaml"/>
                <ResourceDictionary Source="Themes/Controls/Buttons.xaml"/>
                <ResourceDictionary Source="Themes/Controls/Inputs.xaml"/>
                <ResourceDictionary Source="Themes/Controls/Layout.xaml"/>
                <ResourceDictionary Source="Themes/Motion.xaml"/>
                <ResourceDictionary Source="Themes/ViewLocator.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <conv:BooleanToVisibilityInverseConverter x:Key="BooleanToVisibilityInverseConverter"/>
            <conv:BooleanToBooleanInverseConverter x:Key="BooleanToBooleanInverseConverter"/>
            <conv:ZeroCountToVisibilityConverter x:Key="ZeroCountToVisibilityConverter"/>
            <conv:NullOrEmptyToCollapsedConverter x:Key="NullOrEmptyToCollapsedConverter"/>
            <conv:BooleanToBusyTextConverter x:Key="BooleanToBusyTextConverter"/>
            <conv:IntEqualsConverter x:Key="IntEqualsConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:ArchiveActionVisibilityConverter x:Key="ArchiveActionVisibilityConverter"/>
            <conv:AddTwoConverter x:Key="AddTwoConverter"/>
            <conv:EqualStringToVisibilityConverter x:Key="EqualStringToVisibilityConverter"/>
                    <!-- Global rule: any Button's text inherits its Foreground -->
            <Style TargetType="Button">
                <Setter Property="TextElement.Foreground" Value="{Binding RelativeSource={RelativeSource Self}, Path=Foreground}"/>
            </Style>

            <!-- Global rule: enable touchpad two-finger scrolling everywhere -->
            <Style TargetType="ScrollViewer">
                <Setter Property="PanningMode" Value="VerticalOnly" />
                <Setter Property="PanningDeceleration" Value="0.001" />
                <Setter Property="PanningRatio" Value="1.5" />
            </Style>

            <!-- Global ScrollBar override: force the thin style everywhere -->
            <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                <Setter Property="Width" Value="8"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{DynamicResource Brush.Border.Strong}" CornerRadius="4" Margin="2,0"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>





